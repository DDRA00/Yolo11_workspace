# Workspace-local tooling and caches
.agents/
.codex/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.tmp/
.ruff_cache/
.coverage
.coverage.*
.venv/
.venv-qml/

# Runtime output owned by the local workstation
logs/
*.log
station_data/
release_artifacts/
Result/

# Local-only configuration
.env
.env.*
# Endpoint addresses arrive named after their service (qwen.env), which the
# two rules above do not match: they only cover files whose name *starts*
# with .env. The vision client deliberately keeps addresses out of the code,
# so a file like this sitting in the worktree is the one way they still get
# committed.
*.env
!.env.example
